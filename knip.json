{
  "$schema": "https://json.schemastore.org/knip.json",
  "entry": ["src/app/**/page.tsx", "src/app/**/route.ts", "src/app/**/layout.tsx", "src/app/**/opengraph-image.tsx", "proxy.ts", "next.config.mjs", "tests/*.test.mjs", "tests/*.mjs", "e2e/**/*.ts", "playwright.config.ts"],
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "tests/**/*.mjs", "*.{ts,mjs}"],
  "ignore": [
    "references/**",
    "remix-regal-portrait-with-imme/**",
    "audit/**",
    "**/*.css"
  ],
  "ignoreDependencies": [],
  "ignoreBinaries": [],
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  }
}
